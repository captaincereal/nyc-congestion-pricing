# Copy to .env (which is gitignored) and fill in. Never commit .env.

# NYC Open Data (Socrata) app token. This is only a rate-limit identifier for
# public data - it grants no account access - but keep it out of git anyway.
# Register one at https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_OPENDATA_APP_TOKEN=

# Optional: move the data/ tree somewhere with more space.
# NYC_CP_DATA_DIR=D:/nyc-cp-data
